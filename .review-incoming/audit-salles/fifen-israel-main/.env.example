# Flutter build-time values. Never commit a real .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NOTCHPAY_PUBLIC_KEY=your-notchpay-public-key

# Server / Supabase Edge Function secrets only.
# GEMINI_API_KEY must never be added to the Flutter app or Dart source.
GEMINI_API_KEY=your-gemini-api-key
SMART_LESSON_CRON_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notch Pay (secrets Supabase uniquement — jamais dans Flutter) :
#   supabase secrets set NOTCHPAY_PUBLIC_KEY=... NOTCHPAY_WEBHOOK_HASH=...
# NOTCHPAY_WEBHOOK_HASH = « Hash Key » du webhook (tableau de bord Notch Pay), sert à vérifier x-notch-signature.
NOTCHPAY_WEBHOOK_HASH=your-notchpay-webhook-hash-key
